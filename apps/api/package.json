{
  "name": "crm-mvp-api",
  "version": "1.0.0",
  "description": "Express v5 app with typescript",
  "author": "Nishant Kohli",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon --exec 'tsx src/index.ts'",
    "build": "prisma generate && rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "pm2-runtime start ecosystem.config.cjs",
    "start:node": "node dist/index.js",
    "prod": "pnpm build && pnpm start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "common": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pm2": "^7.0.4",
    "winston": "3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nish1896/eslint-flat-config": "^3.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
