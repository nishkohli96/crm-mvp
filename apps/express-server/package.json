{
  "name": "express-server",
  "version": "1.0.0",
  "description": "Express v5 app with typescript",
  "author": "Nishant Kohli",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon --exec 'node -r ts-node/register -r tsconfig-paths/register src/index.ts'",
    "build": "prisma generate && rimraf dist && tsc && tsc-alias",
    "start": "pm2-runtime start ecosystem.config.js",
    "start:node": "node dist/index.js",
    "prod": "pnpm build && pnpm start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint --fix ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "common": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pm2": "^7.0.4",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@nish1896/eslint-flat-config": "^3.1.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "eslint": "^9.39.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
