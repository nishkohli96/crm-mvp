{
  "name": "@nish1896/crm-mvp",
  "author": "Nishant Kohli",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "common:build": "pnpm --filter common run build",
    "express": "pnpm run common:build && pnpm --filter express-server run dev",
    "next": "pnpm run common:build && pnpm --filter next-client run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prettier": "prettier \"{apps,packages}/**/*.{json,html,css,sass,scss}\" --write --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.8"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "ISC"
}
