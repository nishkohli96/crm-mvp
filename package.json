{
  "name": "crm-mvp",
  "author": "Nishant Kohli",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "common": "pnpm --filter common run build",
    "api": "pnpm run common && pnpm --filter crm-mvp-api run dev",
    "next": "pnpm run common && pnpm --filter next-client run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prettier": "prettier \"{apps,packages}/**/*.{json,html,css,sass,scss}\" --write --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.8"
  },
  "packageManager": "pnpm@11.20.0",
  "license": "ISC"
}
